{
  "name": "@bamnet/google-map-tiles",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./mod.ts",
    "./core": "./core.ts"
  },
  "workspaces": [
    "examples"
  ],
  "scripts": {
    "test": "bun test",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p e2e/tsconfig.json",
    "lint": "biome lint .",
    "fmt": "biome format --write .",
    "examples:dev": "bun run --cwd examples dev",
    "examples:build": "bun run --cwd examples build",
    "smoke:node": "node --experimental-transform-types --no-warnings scripts/node_smoke.mjs",
    "generate:logo": "bun scripts/generate_logo.ts"
  },
  "peerDependencies": {
    "maplibre-gl": "^6.14.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.3",
    "maplibre-gl": "^6.14.0",
    "typescript": "^7.0.2"
  }
}
